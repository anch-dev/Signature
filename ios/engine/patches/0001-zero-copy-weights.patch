diff --git a/src/dit-stream.h b/src/dit-stream.h
new file mode 100644
index 0000000..f364902
--- /dev/null
+++ b/src/dit-stream.h
@@ -0,0 +1,276 @@
+#pragma once
+// dit-stream.h: layer-streamed DiT forward (Signature patch).
+//
+// The regular forward is one big graph over all transformer layers, so every
+// layer's weights must be resident at once. In streaming mode the forward is
+// split into a prologue graph (timestep embeddings, proj_in, condition
+// embedder), one graph per transformer layer, and an epilogue graph (AdaLN +
+// proj_out). Before each layer graph runs, that layer's weights are wrapped
+// straight from a read-only mmap of the GGUF; afterwards the wrap is dropped,
+// so at most one layer is resident. The pages are clean and file-backed: the
+// OS keeps them cached when there is room and re-reads them from storage when
+// there isn't. Like ComfyUI's low-VRAM offload, but the tier below is storage.
+//
+// Activations between graphs live in a small persistent backend buffer. The
+// sampler addresses the inputs by name through a dummy graph, so it needs no
+// changes beyond calling dit_stream_compute in place of the static graph.
+
+#include "dit-graph.h"
+#include "dit.h"
+#include "static-graph.h"
+
+#include <cstdio>
+#include <vector>
+
+struct DiTStream {
+    struct ggml_context * pctx = nullptr;  // persistent tensors (no_alloc, backend buffer)
+    ggml_backend_buffer_t pbuf = nullptr;
+    struct ggml_context * gctx = nullptr;  // dummy lookup graph
+    struct ggml_cgraph *  lookup = nullptr;
+    ggml_gallocr_t        galloc = nullptr;
+
+    int T = 0, enc_S = 0, N = 0, S = 0;
+
+    // inputs (named like the full graph's, so the sampler finds them)
+    struct ggml_tensor * input = nullptr, *enc_hidden = nullptr, *t = nullptr, *t_r = nullptr;
+    struct ggml_tensor * positions = nullptr, *sa_mask_sw = nullptr, *ca_mask = nullptr;
+    // carried between graphs
+    struct ggml_tensor * temb = nullptr, *tproj = nullptr, *enc = nullptr;
+    struct ggml_tensor * hidden[2] = { nullptr, nullptr };
+    struct ggml_tensor * velocity = nullptr;
+
+    std::vector<uint8_t> scratch;  // graph-building context memory
+    int                  passes = 0;
+};
+
+static struct ggml_context * dit_stream_scratch(DiTStream * st) {
+    struct ggml_init_params p = { st->scratch.size(), st->scratch.data(), true };
+    return ggml_init(p);
+}
+
+// Compute one graph on the model backend, falling back to the scheduler when
+// the backend lacks an op (same policy as the static graph path).
+static bool dit_stream_run(DiTStream * st, DiTGGML * m, struct ggml_cgraph * gf) {
+    if (static_graph_backend_supports(m->backend, gf)) {
+        if (!st->galloc) {
+            st->galloc = ggml_gallocr_new(ggml_backend_get_default_buffer_type(m->backend));
+        }
+        if (!ggml_gallocr_alloc_graph(st->galloc, gf)) {
+            fprintf(stderr, "[Stream] FATAL: graph allocation failed\n");
+            return false;
+        }
+        return ggml_backend_graph_compute(m->backend, gf) == GGML_STATUS_SUCCESS;
+    }
+    ggml_backend_sched_reset(m->sched);
+    if (!ggml_backend_sched_alloc_graph(m->sched, gf)) {
+        fprintf(stderr, "[Stream] FATAL: sched allocation failed\n");
+        return false;
+    }
+    bool ok = ggml_backend_sched_graph_compute(m->sched, gf) == GGML_STATUS_SUCCESS;
+    ggml_backend_sched_reset(m->sched);
+    return ok;
+}
+
+static struct ggml_tensor * dit_stream_input(struct ggml_context * ctx,
+                                             enum ggml_type        type,
+                                             int64_t               a,
+                                             int64_t               b,
+                                             int64_t               c,
+                                             int64_t               d,
+                                             int                   nd,
+                                             const char *          name) {
+    struct ggml_tensor * t = nd == 1 ? ggml_new_tensor_1d(ctx, type, a) :
+                             nd == 3 ? ggml_new_tensor_3d(ctx, type, a, b, c) :
+                                       ggml_new_tensor_4d(ctx, type, a, b, c, d);
+    ggml_set_name(t, name);
+    ggml_set_input(t);
+    return t;
+}
+
+// Prologue: temb/tproj, proj_in, condition embedder -> st->{temb,tproj,hidden[0],enc}.
+static struct ggml_cgraph * dit_stream_prologue(DiTStream * st, DiTGGML * m, struct ggml_context * ctx,
+                                                bool write) {
+    DiTGGMLConfig & c  = m->cfg;
+    struct ggml_cgraph * gf = ggml_new_graph_custom(ctx, 2048, false);
+
+    struct ggml_tensor * tproj_t;
+    struct ggml_tensor * temb_t = dit_ggml_build_temb(ctx, &m->time_embed, st->t, &tproj_t, "_t");
+    struct ggml_tensor * tproj_r;
+    struct ggml_tensor * t_diff = ggml_sub(ctx, st->t, st->t_r);
+    struct ggml_tensor * temb_r = dit_ggml_build_temb(ctx, &m->time_embed_r, t_diff, &tproj_r, "_r");
+    struct ggml_tensor * temb   = ggml_add(ctx, temb_t, temb_r);
+    struct ggml_tensor * tproj  = ggml_add(ctx, tproj_t, tproj_r);
+
+    struct ggml_tensor * patched = ggml_reshape_3d(ctx, st->input, c.in_channels * c.patch_size, st->S, st->N);
+    struct ggml_tensor * hidden  = dit_ggml_linear_bias(ctx, m->proj_in_w, m->proj_in_b, patched);
+    struct ggml_tensor * enc     = dit_ggml_linear_bias(ctx, m->cond_emb_w, m->cond_emb_b, st->enc_hidden);
+
+    if (!write) {
+        // Shape probe: create the carried tensors with the shapes ggml derived.
+        st->temb      = ggml_new_tensor(st->pctx, GGML_TYPE_F32, ggml_n_dims(temb), temb->ne);
+        st->tproj     = ggml_new_tensor(st->pctx, GGML_TYPE_F32, ggml_n_dims(tproj), tproj->ne);
+        st->hidden[0] = ggml_new_tensor(st->pctx, GGML_TYPE_F32, 3, hidden->ne);
+        st->hidden[1] = ggml_new_tensor(st->pctx, GGML_TYPE_F32, 3, hidden->ne);
+        st->enc       = ggml_new_tensor(st->pctx, GGML_TYPE_F32, 3, enc->ne);
+        return nullptr;
+    }
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, temb, st->temb));
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, tproj, st->tproj));
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, hidden, st->hidden[0]));
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, enc, st->enc));
+    return gf;
+}
+
+static struct ggml_cgraph * dit_stream_epilogue(DiTStream * st, DiTGGML * m, struct ggml_context * ctx,
+                                                struct ggml_tensor * hidden) {
+    DiTGGMLConfig & c  = m->cfg;
+    int             H  = c.hidden_size;
+    struct ggml_cgraph * gf = ggml_new_graph_custom(ctx, 512, false);
+
+    struct ggml_tensor * oss = m->out_scale_shift;
+    if (oss->type != GGML_TYPE_F32) {
+        oss = ggml_cast(ctx, oss, GGML_TYPE_F32);
+    }
+    struct ggml_tensor * oss_flat  = ggml_reshape_1d(ctx, oss, 2 * H);
+    size_t               Hb        = H * sizeof(float);
+    struct ggml_tensor * out_shift = ggml_add(ctx, ggml_view_1d(ctx, oss_flat, H, 0), st->temb);
+    struct ggml_tensor * out_scale = ggml_add(ctx, ggml_view_1d(ctx, oss_flat, H, Hb), st->temb);
+
+    struct ggml_tensor * norm_out = dit_ggml_rms_norm_weighted(ctx, hidden, m->norm_out, c.rms_norm_eps);
+    norm_out                      = dit_ggml_adaln(ctx, norm_out, out_scale, out_shift, m->scalar_one);
+    struct ggml_tensor * output   = dit_ggml_linear_bias(ctx, m->proj_out_w, m->proj_out_b, norm_out);
+    output                        = ggml_reshape_3d(ctx, output, c.out_channels, st->T, st->N);
+    ggml_build_forward_expand(gf, ggml_cpy(ctx, output, st->velocity));
+    return gf;
+}
+
+static void dit_stream_free(DiTStream * st) {
+    if (!st) {
+        return;
+    }
+    if (st->galloc) {
+        ggml_gallocr_free(st->galloc);
+    }
+    if (st->pbuf) {
+        ggml_backend_buffer_free(st->pbuf);
+    }
+    if (st->gctx) {
+        ggml_free(st->gctx);
+    }
+    if (st->pctx) {
+        ggml_free(st->pctx);
+    }
+    delete st;
+}
+
+// Allocate persistent tensors. Returns a lookup graph whose nodes are the
+// named inputs/outputs (never computed), plus input/output pointers.
+static DiTStream * dit_stream_init(DiTGGML *             m,
+                                   int                   T,
+                                   int                   enc_S,
+                                   int                   N,
+                                   struct ggml_cgraph ** p_lookup,
+                                   struct ggml_tensor ** p_input,
+                                   struct ggml_tensor ** p_output) {
+    DiTGGMLConfig & c  = m->cfg;
+    DiTStream *     st = new DiTStream();
+    st->T = T, st->enc_S = enc_S, st->N = N, st->S = T / c.patch_size;
+    st->scratch.resize(ggml_tensor_overhead() * 4096 + ggml_graph_overhead_custom(4096, false));
+
+    struct ggml_init_params pp = { ggml_tensor_overhead() * 64, nullptr, true };
+    st->pctx                   = ggml_init(pp);
+
+    int S      = st->S;
+    int H_enc  = (int) m->cond_emb_w->ne[0];
+    st->input      = dit_stream_input(st->pctx, GGML_TYPE_F32, c.in_channels, T, N, 1, 3, "input_latents");
+    st->enc_hidden = dit_stream_input(st->pctx, GGML_TYPE_F32, H_enc, enc_S, N, 1, 3, "enc_hidden");
+    st->t          = dit_stream_input(st->pctx, GGML_TYPE_F32, 1, 1, 1, 1, 1, "t");
+    st->t_r        = dit_stream_input(st->pctx, GGML_TYPE_F32, 1, 1, 1, 1, 1, "t_r");
+    st->positions  = dit_stream_input(st->pctx, GGML_TYPE_I32, (int64_t) S * N, 1, 1, 1, 1, "positions");
+    st->sa_mask_sw = dit_stream_input(st->pctx, GGML_TYPE_F16, S, S, 1, N, 4, "sa_mask_sw");
+    st->ca_mask    = dit_stream_input(st->pctx, GGML_TYPE_F16, enc_S, S, 1, N, 4, "ca_mask");
+    st->velocity   = ggml_new_tensor_3d(st->pctx, GGML_TYPE_F32, c.out_channels, T, N);
+    ggml_set_name(st->velocity, "velocity");
+
+    // Shape probe for the carried activations.
+    {
+        struct ggml_context * ctx = dit_stream_scratch(st);
+        dit_stream_prologue(st, m, ctx, false);
+        ggml_free(ctx);
+    }
+    st->pbuf = ggml_backend_alloc_ctx_tensors(st->pctx, m->backend);
+    if (!st->pbuf) {
+        fprintf(stderr, "[Stream] FATAL: cannot allocate activation buffer\n");
+        dit_stream_free(st);
+        return nullptr;
+    }
+
+    struct ggml_init_params gp = { ggml_graph_overhead_custom(64, false) + 1024, nullptr, true };
+    st->gctx                   = ggml_init(gp);
+    st->lookup                 = ggml_new_graph_custom(st->gctx, 64, false);
+    struct ggml_tensor * named[] = { st->input,     st->enc_hidden, st->t,       st->t_r,
+                                     st->positions, st->sa_mask_sw, st->ca_mask, st->velocity };
+    for (struct ggml_tensor * t : named) {
+        ggml_graph_add_node(st->lookup, t);
+    }
+    *p_lookup = st->lookup;
+    *p_input  = st->input;
+    *p_output = st->velocity;
+
+    fprintf(stderr, "[Stream] DiT layer streaming on: %d layers, activations %.1f MB\n", c.n_layers,
+            (double) ggml_backend_buffer_get_size(st->pbuf) / 1048576.0);
+    return st;
+}
+
+// One full DiT forward, layer by layer.
+static bool dit_stream_compute(DiTStream * st, DiTGGML * m) {
+    DiTGGMLConfig & c = m->cfg;
+    Timer           timer;
+
+    {
+        struct ggml_context * ctx = dit_stream_scratch(st);
+        bool ok = dit_stream_run(st, m, dit_stream_prologue(st, m, ctx, true));
+        ggml_free(ctx);
+        if (!ok) {
+            return false;
+        }
+    }
+
+    int cur = 0;
+    wctx_stream_prefetch(&m->wctx, 0);
+    for (int i = 0; i < c.n_layers; i++) {
+        if (!wctx_stream_acquire(&m->wctx, i)) {
+            return false;
+        }
+        wctx_stream_prefetch(&m->wctx, i + 1);  // read ahead while this layer runs
+
+        struct ggml_context * ctx = dit_stream_scratch(st);
+        struct ggml_cgraph *  gf  = ggml_new_graph_custom(ctx, 4096, false);
+        struct ggml_tensor *  sa  = (m->layers[i].layer_type == 0) ? st->sa_mask_sw : nullptr;
+        struct ggml_tensor *  out = dit_ggml_build_layer(ctx, m, i, st->hidden[cur], st->tproj, st->enc,
+                                                         st->positions, sa, st->ca_mask, st->S, st->enc_S, st->N);
+        ggml_build_forward_expand(gf, ggml_cpy(ctx, out, st->hidden[cur ^ 1]));
+        bool ok = dit_stream_run(st, m, gf);
+        ggml_backend_synchronize(m->backend);
+        ggml_free(ctx);
+        wctx_stream_release(&m->wctx, i);
+        if (!ok) {
+            return false;
+        }
+        cur ^= 1;
+    }
+
+    {
+        struct ggml_context * ctx = dit_stream_scratch(st);
+        bool ok = dit_stream_run(st, m, dit_stream_epilogue(st, m, ctx, st->hidden[cur]));
+        ggml_free(ctx);
+        if (!ok) {
+            return false;
+        }
+    }
+    if (st->passes++ == 0) {
+        fprintf(stderr, "[Stream] first pass %.0f ms (%.1f MB read)\n", timer.ms(),
+                (double) m->wctx.stream->streamed_bytes / 1048576.0);
+    }
+    return true;
+}
