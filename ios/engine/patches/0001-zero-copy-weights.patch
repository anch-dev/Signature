diff --git a/src/weight-ctx.h b/src/weight-ctx.h
index e43f573..7c95da4 100644
--- a/src/weight-ctx.h
+++ b/src/weight-ctx.h
@@ -14,10 +14,62 @@
 #include "ggml.h"
 
 #include <cstddef>
+#include <cstdint>
 #include <cstdio>
 #include <memory>
+#include <mutex>
+#include <string>
 #include <vector>
 
+#ifndef _WIN32
+#    include <fcntl.h>
+#    include <sys/mman.h>
+#    include <unistd.h>
+#endif
+#include <cstdint>
+
+// ---------------------------------------------------------------------------
+// Zero-copy weights (Signature patch).
+//
+// When enabled and the backend device can wrap host memory (Metal on Apple
+// unified memory, CPU), weights that are used exactly as stored in the GGUF
+// are not copied into a freshly allocated backend buffer. Instead the GGUF is
+// mmapped and the mapping itself becomes the weight buffer. On iOS those pages
+// are clean and file-backed, so they don't count against the app's memory
+// limit the way a private copy does - this is what lets the models run on
+// 4 GB iPhones. Tensors that are converted, fused or adapter-merged at load
+// time still get a normal copy.
+// ---------------------------------------------------------------------------
+inline bool g_wctx_zero_copy = false;
+// Skip QKV / gate+up fusion at load time. Fused tensors are new buffers that
+// can't be mapped from the file, so mapping mode turns fusion off.
+inline bool g_wctx_no_fuse = false;
+
+struct WctxMapping {
+    const uint8_t * base;
+    size_t          size;
+    std::string     path;
+};
+
+inline std::mutex &               wctx_map_mutex() { static std::mutex m; return m; }
+inline std::vector<WctxMapping> & wctx_maps() { static std::vector<WctxMapping> v; return v; }
+
+static void wctx_register_mapping(const void * base, size_t size, const char * path) {
+    std::lock_guard<std::mutex> lock(wctx_map_mutex());
+    wctx_maps().push_back({ (const uint8_t *) base, size, path ? path : "" });
+}
+
+static void wctx_unregister_mapping(const void * base) {
+    std::lock_guard<std::mutex> lock(wctx_map_mutex());
+    auto & v = wctx_maps();
+    for (size_t i = 0; i < v.size(); i++) {
+        if (v[i].base == base) {
+            v.erase(v.begin() + (long) i);
+            return;
+        }
+    }
+}
+
 struct WeightCtx {
     struct ggml_context * ctx;
     ggml_backend_buffer_t buffer;
@@ -35,6 +87,15 @@ struct WeightCtx {
     // unique_ptr keeps the data address stable even when the outer vector grows,
     // so src pointers stored in pending stay valid across staging.push_back().
     std::vector<std::unique_ptr<float[]>> staging;
+
+    // Zero-copy: buffers wrapping our own read-only mmaps of the GGUF files.
+    struct OwnedMap {
+        void * ptr;
+        size_t size;
+    };
+    std::vector<ggml_backend_buffer_t> mapped_buffers;
+    std::vector<OwnedMap>              owned_maps;
+    size_t                             mapped_bytes = 0;
 };
 
 static void wctx_init(WeightCtx * wctx, int n_tensors) {
@@ -48,24 +109,135 @@ static void wctx_init(WeightCtx * wctx, int n_tensors) {
     wctx->buffer = NULL;
     wctx->pending.clear();
     wctx->pending.reserve(n_tensors);
+    wctx->mapped_buffers.clear();
+    wctx->owned_maps.clear();
+    wctx->mapped_bytes = 0;
+}
+
+#ifndef _WIN32
+// Place eligible pending tensors directly on an mmap of their source file.
+static void wctx_map_weights(WeightCtx * wctx, ggml_backend_t backend) {
+    ggml_backend_dev_t dev = ggml_backend_get_device(backend);
+    if (!dev) {
+        return;
+    }
+    struct ggml_backend_dev_props props;
+    ggml_backend_dev_get_props(dev, &props);
+    if (!props.caps.buffer_from_host_ptr) {
+        return;
+    }
+
+    std::vector<WctxMapping> maps;
+    {
+        std::lock_guard<std::mutex> lock(wctx_map_mutex());
+        maps = wctx_maps();
+    }
+
+    for (const WctxMapping & m : maps) {
+        std::vector<size_t> idx;
+        size_t              max_tensor = 0;
+        for (size_t i = 0; i < wctx->pending.size(); i++) {
+            const auto &    pc  = wctx->pending[i];
+            const uint8_t * src = (const uint8_t *) pc.src;
+            if (pc.offset != 0 || pc.nbytes == 0 || pc.nbytes != ggml_nbytes(pc.tensor)) {
+                continue;  // fused / partial copy
+            }
+            if (src < m.base || src + pc.nbytes > m.base + m.size) {
+                continue;  // staging data (converted or adapter-merged)
+            }
+            idx.push_back(i);
+            max_tensor = pc.nbytes > max_tensor ? pc.nbytes : max_tensor;
+        }
+        if (idx.empty() || m.path.empty()) {
+            continue;
+        }
+
+        // Map only the slice of the file these tensors live in, and only when
+        // they fill most of it; otherwise mapping would keep unrelated parts of
+        // the file resident and cost more than a copy.
+        size_t lo = SIZE_MAX, hi = 0, want = 0;
+        for (size_t i : idx) {
+            size_t off = (size_t) ((const uint8_t *) wctx->pending[i].src - m.base);
+            lo         = off < lo ? off : lo;
+            hi         = off + wctx->pending[i].nbytes > hi ? off + wctx->pending[i].nbytes : hi;
+            want += wctx->pending[i].nbytes;
+        }
+        const size_t page = (size_t) sysconf(_SC_PAGESIZE);
+        lo                = lo / page * page;
+        size_t span       = hi - lo;
+        if ((double) want < 0.75 * (double) span) {
+            fprintf(stderr, "[WeightCtx] mapping skipped: %.1f MB of tensors spread over %.1f MB of file\n",
+                    (double) want / 1048576.0, (double) span / 1048576.0);
+            continue;
+        }
+        span = (span + page - 1) / page * page;
+
+        // Our own mapping: the loader unmaps its copy right after wctx_alloc.
+        int fd = open(m.path.c_str(), O_RDONLY);
+        if (fd < 0) {
+            continue;
+        }
+        void * ptr = mmap(NULL, span, PROT_READ, MAP_SHARED, fd, (off_t) lo);
+        close(fd);
+        if (ptr == MAP_FAILED) {
+            continue;
+        }
+        ggml_backend_buffer_t buf = ggml_backend_dev_buffer_from_host_ptr(dev, ptr, span, max_tensor);
+        if (!buf) {
+            munmap(ptr, span);
+            continue;
+        }
+        ggml_backend_buffer_set_usage(buf, GGML_BACKEND_BUFFER_USAGE_WEIGHTS);
+
+        size_t bytes = 0;
+        for (size_t i : idx) {
+            auto & pc   = wctx->pending[i];
+            void * addr = (uint8_t *) ptr + ((size_t) ((const uint8_t *) pc.src - m.base) - lo);
+            if (ggml_backend_tensor_alloc(buf, pc.tensor, addr) == GGML_STATUS_SUCCESS) {
+                bytes += pc.nbytes;
+                pc.nbytes = 0;  // mapped, nothing to copy
+            }
+        }
+        wctx->mapped_buffers.push_back(buf);
+        wctx->owned_maps.push_back({ ptr, span });
+        wctx->mapped_bytes += bytes;
+    }
 }
+#endif
 
